# NativaCare production environment
# Never commit real secrets. Configure these in Railway/Netlify environment settings.

# AI
CEREBRAS_API_KEY=
LLM_MODEL=gpt-oss-120b

# Catalog / schedules
GOOGLE_SHEET_ID=

# PERMANENT STORAGE — required in production.
# In Railway add a PostgreSQL service and expose its DATABASE_URL to this app.
# App redeploys/restarts then do not delete patients, appointments, invoices,
# conversation logs, takeover state, or saved chatbot context.
DATABASE_URL=

# Google Calendar
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_CREDENTIALS_JSON=

# Email
RESEND_API_KEY=
FROM_EMAIL=
CLINIC_EMAIL=

# Brand/contact — no physical office address is used by the chatbot.
CLINIC_NAME=NativaCare
CLINIC_PHONE=971 50 7297197
CLINIC_TIMEZONE=Asia/Dubai

# WhatsApp / Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
OWNER_WHATSAPP_NUMBER=

# Admin dashboard
ADMIN_API_KEY=

# Payments
PAYMENT_ENABLED=false
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_IBAN=
FRONTEND_BASE_URL=

# Payment screenshots are files, not ordinary DB rows. Until object storage
# is added, mount a Railway persistent Volume and point UPLOADS_DIR at it.
# Example volume mount: /data ; then use /data/uploads below.
UPLOADS_DIR=/data/uploads

# Optional crawler
CRAWLER_NOTIFY_EMAIL=
NATIVA_SERVICES_URL=https://nativacare.com/services/
CRAWLER_STATE_FILE=/data/.crawler_state.json
