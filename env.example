# =============================================================================
# NativaCare Chatbot — Environment variables
#
# Copy this file to `.env` (no extension prefix) and fill in real values.
# `.env` should never be committed to git — make sure it's in .gitignore.
#
# Every section below explains:
#   - What the variable is for
#   - Whether it's required or optional
#   - What happens if you leave it blank
# =============================================================================


# -----------------------------------------------------------------------------
# LLM — Groq (REQUIRED for the bot to do real NLU / replies)
# -----------------------------------------------------------------------------
# Without these, the bot falls back to a basic regex classifier and
# generic replies. The bot still runs but is much less useful.
#
# Get a key at: https://cloud.sambanova.ai/apis  (no credit card needed)
# Free tier: persistent free access + $5 starter credit (expires 30 days).
# Developer tier (add credit card): 20M tokens/day, 10,000+ TPM on 70B+
# models, pay-as-you-go.
#
# Model: Meta-Llama-3.3-70B-Instruct — SambaNova's most battle-tested
# model. ~282-430 tokens/sec on SambaNova's RDU hardware. The model ID
# is case-sensitive — use exactly "Meta-Llama-3.3-70B-Instruct".
#
# The bot also accepts GROQ_API_KEY or CEREBRAS_API_KEY env var names
# for backward compatibility with older deployments. Whichever name you
# use, the VALUE must be a real SambaNova API key.
SAMBANOVA_API_KEY=
LLM_MODEL=Meta-Llama-3.3-70B-Instruct


# -----------------------------------------------------------------------------
# Data source — Google Sheet (OPTIONAL but strongly recommended)
# -----------------------------------------------------------------------------
# The Sheet ID is the long string in the URL between `/d/` and `/edit`.
# Example: https://docs.google.com/spreadsheets/d/1AbC...xYz/edit
#                                                  ^^^^^^^^^^^
# Share the sheet as "Anyone with the link can view" — no auth needed.
#
# If left blank, the bot uses hardcoded DEMO fallback data and prints
# warnings on startup. Fine for development, NOT fine for production.
GOOGLE_SHEET_ID=


# -----------------------------------------------------------------------------
# Google Calendar (OPTIONAL — bot writes events here when configured)
# -----------------------------------------------------------------------------
# If blank, bookings still complete — they just don't get written to a
# calendar. The clinic team will only see them via email + the
# /appointments endpoint.
#
# To use:
# 1. Create a Google service account in Google Cloud Console.
# 2. Enable the Google Calendar API for that project.
# 3. Download the service account's JSON key file.
# 4. Share your target Google Calendar with the service account email
#    (it looks like xxx@yyy.iam.gserviceaccount.com) — give it
#    "Make changes to events" permission.
# 5. The Calendar ID is in Calendar settings > Integrate calendar.
GOOGLE_CALENDAR_ID=

# For local development, point to the service account JSON file:
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# For cloud deployments (Railway, Render, Fly, etc.) paste the entire
# service account JSON as ONE LINE here instead (and leave the file
# path above as-is — it's used only as a fallback).
# Example: {"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_CREDENTIALS_JSON=


# -----------------------------------------------------------------------------
# Email — Resend (OPTIONAL — confirmations skipped if missing)
# -----------------------------------------------------------------------------
# Without these, bookings still complete but no confirmation emails go
# out. The bot prints "[Email] Skipped" on each booking instead.
#
# Get a key at: https://resend.com/api-keys
RESEND_API_KEY=

# Sender address — must be from a domain you've verified in Resend.
# Example: bookings@nativacare.com
FROM_EMAIL=

# Where new-booking notifications go to the clinic team.
# Example: info@nativacare.com
CLINIC_EMAIL=


# -----------------------------------------------------------------------------
# Clinic identity (OPTIONAL — used in greetings and emails)
# -----------------------------------------------------------------------------
# All have sensible defaults. Override if the clinic info ever changes
# without you wanting to update the Google Sheet.
CLINIC_NAME=NativaCare
CLINIC_PHONE=+971507297197
CLINIC_TIMEZONE=Asia/Dubai


# -----------------------------------------------------------------------------
# Services-diff crawler (OPTIONAL — only if running crawl_services.py)
# -----------------------------------------------------------------------------
# If left blank, the crawler emails CLINIC_EMAIL above (or skips if neither
# is set). Set this if you want diff notifications going somewhere else.
CRAWLER_NOTIFY_EMAIL=

# Override the page URL if NativaCare ever restructures their site.
NATIVA_SERVICES_URL=https://nativacare.com/services/

# Where the crawler stores its "last-seen diff" memory between runs.
# On platforms with ephemeral filesystems (GitHub Actions), see the
# deployment notes in crawl_services.py for how to persist this.
CRAWLER_STATE_FILE=.crawler_state.json


# -----------------------------------------------------------------------------
# WhatsApp (Meta Cloud API — direct, no BSP/no BSP markup)
# -----------------------------------------------------------------------------
# All four values below come from the Meta App Dashboard during the
# test-number phase: developers.facebook.com -> Your App -> WhatsApp ->
# API Setup. WHATSAPP_VERIFY_TOKEN is the one exception — that's a string
# YOU make up (anything, e.g. a random password), which you enter in BOTH
# this file and the "Verify token" field when you register the webhook URL
# in the Meta dashboard. They just need to match each other.
#
# Without these, the bot still runs fine for website chat — WhatsApp
# messages just won't be answered (webhook verification will fail, or
# replies will be skipped and logged if verification alone is configured).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional but recommended once you move past the test-number phase —
# enables verifying that inbound webhook calls really came from Meta.
WHATSAPP_APP_SECRET=


# -----------------------------------------------------------------------------
# Payment integration (OPTIONAL — placeholder for future Stripe integration)
# -----------------------------------------------------------------------------
# When PAYMENT_ENABLED=true, the bot inserts a payment step between the
# booking confirmation ("yes") and the actual calendar commit. The user
# gets a payment link and types "paid" once they've completed payment.
#
# Currently a PLACEHOLDER: the link goes to a fake URL, and the bot trusts
# the user when they type "paid" (no real verification). This exists so
# we can test the conversation flow before wiring real Stripe integration.
#
# Default is FALSE — bot behaves as before, booking commits directly on
# "yes" without a payment step. Flip to TRUE only when you're ready to
# test the payment flow.
PAYMENT_ENABLED=false

# The placeholder payment link is built as {PAYMENT_LINK_BASE_URL}/{ref}
# Change this when you wire real Stripe Checkout Sessions.
PAYMENT_LINK_BASE_URL=https://pay.nativacare.com/checkout


# =============================================================================
# Quick reference: what works without each variable
# =============================================================================
#
#   SAMBANOVA_API_KEY missing -> bot uses regex fallback (basic but works)
#   GOOGLE_SHEET_ID missing  -> bot uses demo data (clearly marked [DEMO])
#   GOOGLE_CALENDAR_ID missing -> bookings complete but no calendar event
#   RESEND_API_KEY missing   -> bookings complete but no emails sent
#   PAYMENT_ENABLED=false    -> booking commits on "yes" (no payment step)
#
# So the bot will start and run with EVERY variable blank — it just
# won't be very useful. The minimum useful configuration is:
#   SAMBANOVA_API_KEY + GOOGLE_SHEET_ID
# Add Calendar + Resend when ready to send real bookings to real patients.
